<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform refuses to start without this: it caps the display link at 60 Hz
	     on ProMotion iPhones. See androidx.compose.ui.uikit.PlistSanityCheck. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Bobbin</string>
	<!-- Sin esta clave LocalAuthentication no puede usar Face ID. Traducciones en <lang>.lproj. -->
	<key>NSFaceIDUsageDescription</key>
	<string>To open your journal with Face ID when the lock is on.</string>
	<!-- La app no usa cifrado propio, solo HTTPS del sistema. Sin esta clave App Store Connect
	     pregunta por el cumplimiento de exportacion en cada build y la retiene hasta responder. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- El widget y los enlaces abren la app con bobbin://. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.baltajmn.bullet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bobbin</string>
			</array>
		</dict>
	</array>
	<!-- Una lista enviada, .bobbin (docs/tecnico.md 12.11). Sin abrir en sitio: el sistema deja una
	     copia en Inbox, que BobbinBridge.open lee y borra. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.baltajmn.bullet.list</string>
			<key>UTTypeDescription</key>
			<string>Bobbin list</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bobbin</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.baltajmn.bobbin+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bobbin list</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.baltajmn.bullet.list</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
		<string>fr</string>
	</array>
</dict>
</plist>
