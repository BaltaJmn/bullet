// Team ID de la cuenta de Apple Developer (App Store Connect > Membership > Team ID).
TEAM_ID=BR5ZH8XYP6

PRODUCT_NAME=Bobbin

// El identificador es irreversible en cuanto se sube la primera build a App Store Connect,
// igual que el applicationId de Android. Se deja igual que Android a proposito.
APP_BUNDLE_ID=com.baltajmn.bullet
PRODUCT_BUNDLE_IDENTIFIER=$(APP_BUNDLE_ID)

// Ninguno de los dos se toca para publicar: release-ios.yml (y ~/keys/testflight.sh) los pisan con
// versionName y versionCode de androidApp/build.gradle.kts, un solo numero para las dos tiendas. El
// valor de aqui solo lo usa un archivado a mano desde Xcode, y ese si hay que subirlo, porque App
// Store Connect rechaza un build repetido.
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0.0
