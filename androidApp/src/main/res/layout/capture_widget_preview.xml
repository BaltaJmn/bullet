<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para el selector de widgets, que infla RemoteViews y no sabe de Glance (docs/tecnico.md 8.2).
  Se mantiene a mano: el glifo de la tarea y "Escribir".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@color/widget_background">

    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no"
        android:src="@drawable/glyph_task" android:tint="@color/widget_on_background" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
        android:text="@string/widget_capture_write" android:textColor="@color/widget_on_background"
        android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
